APP_ENV=local
APP_ORIGIN=https://app.example.com
TELEGRAM_BOT_TOKEN=<set-on-server-only>
SESSION_PEPPER=<set-a-long-random-server-only-secret>
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=telegram_invoice
DB_USER=telegram_invoice
DB_PASSWORD=<set-on-server-only>
AUTH_MAX_AGE_SECONDS=300
AUTH_FUTURE_SKEW_SECONDS=30
SESSION_IDLE_TTL_SECONDS=604800
SESSION_ABSOLUTE_TTL_SECONDS=2592000
SESSION_TOUCH_INTERVAL_SECONDS=300
AUTH_RATE_LIMIT_PER_MINUTE=30
WRITE_RATE_LIMIT_PER_MINUTE=120
