Options -Indexes
DirectoryIndex index.html

RewriteEngine On

# The contained PHP runtime is executable only through internal PHP includes.
# Never serve its files directly over HTTP.
RewriteRule ^tinv-runtime(?:/|$) - [F,L]

# The staging runtime config is uploaded to DocumentRoot for cPanel FTPS
# compatibility, but must never be retrievable over HTTP.
RewriteRule ^tinv-runtime\.env$ - [F,L]

# Keep the V1 API same-origin and route every API path through PHP.
RewriteRule ^api(?:/|$) index.php [L,QSA]

# Serve compiled frontend assets directly.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Mini App client-side fallback.
RewriteRule ^ index.html [L]

# Staging must never be indexable. Keep this host-specific so a future
# production origin is not accidentally noindexed by the shared codebase.
<IfModule mod_setenvif.c>
  SetEnvIfNoCase Host "^invoice-staging\.box4u\.co(?::[0-9]+)?$" TINV_STAGING_NOINDEX=1
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive" env=TINV_STAGING_NOINDEX
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors https://web.telegram.org https://*.telegram.org"
</IfModule>
